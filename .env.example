# Subtitle API Configuration
# The base URL of your FastAPI backend for YouTube subtitle fetching
# For local development, use: http://127.0.0.1:8000
# For production, use your deployed backend URL
VITE_SUBTITLES_BASE_URL=http://127.0.0.1:8000

# API Key for authenticating with the subtitle backend
# This key must match the API_KEY configured on your FastAPI backend
# See BACKEND_AUTH_SETUP.md for backend setup instructions
VITE_SUBTITLES_API_KEY=your_api_key_here

# Note: After adding/changing these values, restart the dev server with `npm run dev`
# For production builds, run `npm run build` which will use these values
