{
	"manifest_version": 3,
	"name": "Mimir",
	"version": "1.0.0",
	"description": "Extract rendered text from open tabs grouped by domain",
	"icons": {
		"16": "files.png",
		"48": "files.png",
		"128": "files.png"
	},
	"action": {
		"default_icon": "files.png",
		"default_title": "Mimir"
	},
	"permissions": ["scripting", "activeTab", "storage", "sidePanel", "tabs", "clipboardWrite"],
	"host_permissions": ["http://*/*", "https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
	"background": {
		"service_worker": "src/background/index.ts",
		"type": "module"
	},
	"side_panel": {
		"default_path": "src/sidepanel/index.html"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+Y",
				"mac": "Command+Shift+Y"
			}
		},
		"extract-to-right": {
			"suggested_key": {
				"default": "Ctrl+Shift+Right",
				"mac": "Command+Shift+Right"
			},
			"description": "Extract tabs to the right"
		},
		"extract-selected": {
			"suggested_key": {
				"default": "Ctrl+Shift+Down",
				"mac": "Command+Shift+Down"
			},
			"description": "Extract selected tabs"
		},
		"extract-highlighted": {
			"suggested_key": {
				"default": "Ctrl+Shift+Left",
				"mac": "Command+Shift+Left"
			},
			"description": "Extract highlighted tabs"
		}
	}
}
