{
  "manifest_version": 3,
  "name": "Mimir",
  "version": "1.0.0",
  "description": "Extract rendered text from open tabs grouped by domain",
  "icons": {
    "16": "files.png",
    "48": "files.png",
    "128": "files.png"
  },
  "action": {
    "default_icon": "files.png",
    "default_title": "Mimir"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "sidePanel",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  }
}
